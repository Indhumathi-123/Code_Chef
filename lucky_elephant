import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
public static void main(String [] args)
{
   Scanner sc = new Scanner(System.in);
   int K = sc.nextInt();
   int N = sc.nextInt();
   String[] inputstr = new String[K];
   for(int i =0;i<K;i++){
       inputstr[i] = sc.next();
   }
   for(int i=0;i<N;i++){
       String pillow = sc.next();
       if(pillow.length()>=47){
           System.out.println("Good");
           continue;
       }
       boolean found =false;
       for(int j=0;j<K;j++){
           if(pillow.contains(inputstr[j])){
               found = true;
           }
       }
       if(found){
           System.out.println("Good");
       }
       else{
           System.out.println("Bad");
       }
   }
}
